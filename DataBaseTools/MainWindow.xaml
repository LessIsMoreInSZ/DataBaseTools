<Window
    x:Class="DataBaseTools.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SQL Server 数据维护工具 (.NET 6)"
    Width="980"
    Height="680"
    mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.ColumnSpan="2"
            Padding="14"
            Background="#FFF6F8FB"
            BorderBrush="#FFD6DEE8"
            BorderThickness="1"
            CornerRadius="10">
            <StackPanel>
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="SQL Server 数据维护工具" />
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="#FF465467"
                    Text="适合做整库备份、读取表列表、清理旧数据和补建索引。建议先备份，再执行删数。" />
            </StackPanel>
        </Border>

        <GroupBox
            Grid.Row="1"
            Margin="0,16,12,0"
            Header="1. 连接与备份">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Margin="0,0,12,12"
                    VerticalAlignment="Center"
                    Text="数据库名称" />
                <TextBox
                    Grid.Column="1"
                    Margin="0,0,0,12"
                    Padding="10,6"
                    Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="1"
                    Margin="0,0,12,12"
                    VerticalAlignment="Center"
                    Text="备份目录" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,0,12"
                    Padding="10,6"
                    Text="{Binding BackupDirectory, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="2"
                    Margin="0,0,12,12"
                    VerticalAlignment="Center"
                    Text="备份文件名" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,0,0,12"
                    Padding="10,6"
                    Text="{Binding BackUpFileName, UpdateSourceTrigger=PropertyChanged}" />

                <WrapPanel
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="0,0,0,12">
                    <Button
                        Width="110"
                        Height="34"
                        Margin="0,0,10,0"
                        Command="{Binding PitchOnCommand}"
                        Content="读取表列表" />
                    <Button
                        Width="120"
                        Height="34"
                        Margin="0,0,10,0"
                        Command="{Binding RefreshSummaryCommand}"
                        Content="读取数据库概览" />
                    <Button
                        Width="110"
                        Height="34"
                        Command="{Binding WholeLibraryBackupCommand}"
                        Content="执行整库备份" />
                </WrapPanel>

                <TextBlock
                    Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Foreground="#FF54657A"
                    Text="提示：配置来自 toolsettings.json，备份文件会写入上方目录。" />
            </Grid>
        </GroupBox>

        <GroupBox
            Grid.Row="1"
            Grid.Column="1"
            Margin="12,16,0,0"
            Header="2. 清理与优化">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Margin="0,0,12,12"
                    VerticalAlignment="Center"
                    Text="目标表名" />
                <ComboBox
                    Grid.Column="1"
                    Margin="0,0,0,12"
                    Padding="8,4"
                    ItemsSource="{Binding Tables}"
                    SelectedItem="{Binding CurrentSelectTable}" />

                <TextBlock
                    Grid.Row="1"
                    Margin="0,0,12,12"
                    VerticalAlignment="Center"
                    Text="保留行数" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,0,12"
                    Padding="10,6"
                    Text="{Binding KeepRowsText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Foreground="#FF54657A"
                    Text="删数逻辑依赖 ID 列，并且会先校验是否存在同名备份文件。" />

                <WrapPanel
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Margin="0,12,0,0">
                    <Button
                        Width="160"
                        Height="34"
                        Margin="0,0,10,0"
                        Command="{Binding DeleteLeft1000Command}"
                        Content="保留最新记录并删旧数据" />
                    <Button
                        Width="150"
                        Height="34"
                        Command="{Binding CreateIndexCommand}"
                        Content="补建 chart 时间索引" />
                </WrapPanel>
            </Grid>
        </GroupBox>

        <GroupBox
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Margin="0,16,0,0"
            Header="3. 数据库概览与操作建议">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox
                    Margin="0,0,0,12"
                    Padding="12"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    Text="{Binding DatabaseSummary}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />

                <StackPanel Grid.Row="1">
                    <TextBlock Text="建议流程：" />
                    <TextBlock Margin="0,6,0,0" Text="1. 先确认数据库名称和备份目录是否正确。" />
                    <TextBlock Margin="0,4,0,0" Text="2. 点击“读取表列表”和“读取数据库概览”确认目标环境。" />
                    <TextBlock Margin="0,4,0,0" Text="3. 执行整库备份，确认 .bak 文件已经生成。" />
                    <TextBlock Margin="0,4,0,0" Text="4. 再选择数据表，设置保留行数，执行删旧数据或补建索引。" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <Border
            Grid.Row="3"
            Grid.ColumnSpan="2"
            Margin="0,16,0,0"
            Padding="12"
            Background="#FFF8FAFC"
            BorderBrush="#FFD7E0EA"
            BorderThickness="1"
            CornerRadius="8">
            <TextBlock
                Text="{Binding StatusMessage}"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
